NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gym_management
DB_CONNECTION_LIMIT=10

# Use * during local development, or a comma-separated list, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ORIGINS=*

# Email recovery (server only; never put credentials in Mobile/.env.local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="QA-Gym <your-email@gmail.com>"

# Shop checkout. Demo works only outside production; no actual money is charged.
SHOP_PAYMENT_MODE=manual
SHOP_SHIPPING_FEE_VND=0
# Server/staff only. Do not put this key in Mobile or commit real credentials.
SHOP_PAYMENT_CONFIRM_KEY=
